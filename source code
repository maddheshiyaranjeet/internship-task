const char WIFI_PASS[] = "";

/* ============================================================
   BATTERY LIMITS
   ============================================================ */

const float CELL_MIN_V = 2.50;
const float CELL_MAX_V = 4.20;

const float UNDER_VOLTAGE = 2.80;
const float OVER_VOLTAGE = 4.15;

const float MINOR_IMBALANCE = 3.0;
const float CRITICAL_IMBALANCE = 10.0;

const float MAX_DVDT = 0.15;

/* ============================================================
   TIMING
   ============================================================ */

const unsigned long SENSOR_PERIOD = 100;
const unsigned long SAFETY_PERIOD = 100;
const unsigned long HMI_PERIOD = 100;

const unsigned long SCREEN_PERIOD = 4000;

const unsigned long TELEMETRY_PERIOD = 2000;
const unsigned long HISTORY_PERIOD = 5000;

const unsigned long WIFI_RETRY_PERIOD = 10000;

const unsigned long FAULT_DEBOUNCE = 500;
const unsigned long COOLDOWN_PERIOD = 3000;
const unsigned long RELAY_GUARD_PERIOD = 2000;

const unsigned long ADC_FREEZE_PERIOD = 3000;

/* ============================================================
   BATTERY DATA
   ============================================================ */

float cellVoltage[4] = {
  3.70, 3.70, 3.70, 3.70
};

float previousVoltage[4] = {
  3.70, 3.70, 3.70, 3.70
};

unsigned long lastADCChange[4] = {
  0, 0, 0, 0
};

float packVoltage = 14.8;
float averageVoltage = 3.70;

float deltaVoltage = 0.0;
float imbalancePercent = 0.0;

int weakestCell = 0;
int strongestCell = 0;

int soc = 71;

/* ============================================================
   STATES
   ============================================================ */

enum BatteryHealth {
  HEALTHY,
  MINOR_IMBALANCE_STATE,
  CRITICAL_IMBALANCE_STATE,
  PACK_FAILURE_STATE
};

BatteryHealth batteryHealth = HEALTHY;


enum SafetyState {
  SAFETY_NORMAL,
  SAFETY_FAULT,
  SAFETY_COOLDOWN
};

SafetyState safetyState = SAFETY_NORMAL;


enum RuntimeState {
  RUNTIME_NORMAL,
  RUNTIME_DEGRADED,
  RUNTIME_FAILSAFE,
  RUNTIME_SHUTDOWN
};

RuntimeState runtimeState = RUNTIME_NORMAL;


enum FaultType {
  NO_FAULT,
  UV_FAULT,
  OV_FAULT,
  RAPID_CHANGE_FAULT,
  SENSOR_INVALID_FAULT,
  SENSOR_FROZEN_FAULT,
  RELAY_MISMATCH_FAULT
};

FaultType activeFault = NO_FAULT;

/* ============================================================
   TIMERS
   ============================================================ */

unsigned long lastSensor = 0;
unsigned long lastSafety = 0;
unsigned long lastHMI = 0;
unsigned long lastScreen = 0;
unsigned long lastTelemetry = 0;
unsigned long lastHistory = 0;
unsigned long lastWiFiAttempt = 0;

unsigned long faultCandidateStart = 0;
unsigned long cooldownStart = 0;
unsigned long lastRelayTransition = 0;

/* ============================================================
   RELAY
   ============================================================ */

bool relayCommand = false;

/* ============================================================
   HMI
   ============================================================ */

uint8_t currentScreen = 0;

String previousLine1 = "";
String previousLine2 = "";

/* ============================================================
   BUZZER
   ============================================================ */

unsigned long lastBuzzerToggle = 0;
bool buzzerState = false;

/* ============================================================
   EVENT QUEUE
   ============================================================ */

struct EventRecord {
  unsigned long timestamp;
  String text;
};

const uint8_t EVENT_QUEUE_SIZE = 20;

EventRecord eventQueue[EVENT_QUEUE_SIZE];

uint8_t eventHead = 0;
uint8_t eventTail = 0;
uint8_t eventCount = 0;

/* ============================================================
   FAULT LOG
   ============================================================ */

