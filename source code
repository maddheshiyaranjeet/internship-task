const uint8_t CELL3_PIN = 32;
const uint8_t CELL4_PIN = 33;

const uint8_t BUZZER_PIN = 14;
const uint8_t RELAY_PIN = 13;

const uint8_t RED_LED_PIN = 25;
const uint8_t YELLOW_LED_PIN = 26;
const uint8_t GREEN_LED_PIN = 27;

